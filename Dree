title.Text = "DEX HUB"
title.BackgroundTransparency = 1
title.Font = Enum.Font.SourceSansBold
title.TextScaled = true

-------------------------------------------------
-- SIDEBAR
-------------------------------------------------
local sidebar = Instance.new("Frame", hub)
sidebar.Position = UDim2.new(0,0,0,35)
sidebar.Size = UDim2.new(0,110,1,-35)
