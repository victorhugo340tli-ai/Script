-- MAIN
local main = Instance.new("Frame", hub)
main.Position = UDim2.new(0,120,0,45)
main.Size = UDim2.new(1,-130,1,-55)
main.BackgroundColor3 = AMARELO
main.BorderSizePixel = 0

local function clearMain()
	for _,v in pairs(main:GetChildren()) do
		v:Destroy()
	end
end

-------------------------------------------------
-- SWITCH
-------------------------------------------------
local function createSwitch(text, posY, callback)
	local label = Instance.new("TextLabel", main)
	label.Text = text
	label.Position = UDim2.new(0,10,0,posY)
	label.Size = UDim2.new(0.6,0,0,30)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.SourceSans

	local btn = Instance.new("TextButton", main)
	btn.Position = UDim2.new(0.65,0,0,posY)
	btn.Size = UDim2.new(0,80,0,30)
	btn.Text = "OFF"
	btn.BackgroundColor3 = VERMELHO
	btn.TextScaled = true

	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = state and "ON" or "OFF"
		btn.BackgroundColor3 = state and VERDE or VERMELHO
		callback(state)
	end)
end

