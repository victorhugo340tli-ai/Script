-- DEX HUB UI (EDUCACIONAL)
local player = game.Players.LocalPlayer
local UIS = game:GetService("UserInputService")

-- SCREEN GUI
local gui = Instance.new("ScreenGui")
gui.Name = "DexHubGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- CORES
local AMARELO = Color3.fromRGB(230,255,80)
local CINZA = Color3.fromRGB(40,40,40)
local VERDE = Color3.fromRGB(60,255,60)
local VERMELHO = Color3.fromRGB(255,60,60)

-------------------------------------------------
-- BOTÃO ÍCONE (ABRIR / FECHAR)
-------------------------------------------------
local icon = Instance.new("ImageButton", gui)
icon.Size = UDim2.new(0,50,0,50)
icon.Position = UDim2.new(0,20,0.5,-25)
icon.Image = "rbxassetid://7072719338" -- ícone exemplo
icon.BackgroundColor3 = AMARELO
icon.BorderSizePixel = 0
icon.AutoButtonColor = true

-------------------------------------------------
-- HUB PRINCIPAL
-------------------------------------------------
local hub = Instance.new("Frame", gui)
hub.Size = UDim2.new(0,420,0,260)
hub.Position = UDim2.new(0.5,-210,0.5,-130)
hub.BackgroundColor3 = AMARELO
hub.Visible = false
hub.BorderSizePixel = 0

-- ARRASTAR HUB
local dragging, dragStart, startPos
hub.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = hub.Position
	end
end)

hub.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		hub.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

-- ABRIR / FECHAR HUB
icon.MouseButton1Click:Connect(function()
	hub.Visible = not hub.Visible
end)

-------------------------------------------------
-- TÍTULO
-------------------------------------------------
local title = Instance.new("TextLabel", hub)
